{
  "name": "ActivityPath",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Path name"
    },
    "description": {
      "type": "string",
      "description": "Path description"
    },
    "order": {
      "type": "number",
      "description": "Display order",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "description": "Whether path is active",
      "default": true
    },
    "department_id": {
      "type": "string",
      "description": "Assigned to department"
    },
    "team_id": {
      "type": "string",
      "description": "Assigned to team"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}